#!/usr/bin/env zsh
# Automatic Cleanup Script for Versioner
# Automatically detects and cleans build artifacts, temporary files, and Docker resources

set -Eeuo pipefail
IFS=$'\n\t'

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Script configuration
SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Statistics
CLEANED_FILES=0
CLEANED_DIRS=0
CLEANED_DOCKER=0

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Validate environment
validate_environment() {
    log_info "Validating environment..."
    
    if [[ ! -d "$PROJECT_ROOT" ]]; then
        log_error "Project root not found: $PROJECT_ROOT"
        exit 1
    fi
    
    log_success "Environment validation passed"
}

# Clean .bak files
clean_bak_files() {
    log_info "Cleaning .bak files from repository..."
    
    local bak_files
    bak_files=$(find "$PROJECT_ROOT" -name "*.bak" -type f 2>/dev/null || true)
    
    if [[ -n "$bak_files" ]]; then
        local count=0
        while IFS= read -r file; do
            [[ -n "$file" ]] || continue
            if rm -f "$file" 2>/dev/null; then
                count=$((count + 1))
            fi
        done <<< "$bak_files"
        
        if [[ $count -gt 0 ]]; then
            CLEANED_FILES=$((CLEANED_FILES + count))
            log_success "Removed $count .bak file(s)"
        fi
    else
        log_info "No .bak files found"
    fi
}

# Clean obj directories
clean_obj_directories() {
    log_info "Cleaning obj directories from .NET projects..."
    
    local obj_dirs
    obj_dirs=$(find "$PROJECT_ROOT" -name "obj" -type d 2>/dev/null || true)
    
    if [[ -n "$obj_dirs" ]]; then
        local count=0
        while IFS= read -r dir; do
            [[ -n "$dir" ]] || continue
            if [[ -d "$dir" ]]; then
                if rm -rf "$dir" 2>/dev/null; then
                    count=$((count + 1))
                fi
            fi
        done <<< "$obj_dirs"
        
        if [[ $count -gt 0 ]]; then
            CLEANED_DIRS=$((CLEANED_DIRS + count))
            log_success "Removed $count obj directory(ies)"
        fi
    else
        log_info "No obj directories found"
    fi
}

# Clean bin directories
clean_bin_directories() {
    log_info "Cleaning bin directories from .NET projects..."
    
    local bin_dirs
    bin_dirs=$(find "$PROJECT_ROOT" -name "bin" -type d 2>/dev/null || true)
    
    if [[ -n "$bin_dirs" ]]; then
        local count=0
        while IFS= read -r dir; do
            [[ -n "$dir" ]] || continue
            if [[ -d "$dir" ]]; then
                if rm -rf "$dir" 2>/dev/null; then
                    count=$((count + 1))
                fi
            fi
        done <<< "$bin_dirs"
        
        if [[ $count -gt 0 ]]; then
            CLEANED_DIRS=$((CLEANED_DIRS + count))
            log_success "Removed $count bin directory(ies)"
        fi
    else
        log_info "No bin directories found"
    fi
}

# Clean DEPLOYMENT directory
clean_deployment_directory() {
    log_info "Checking for DEPLOYMENT directory..."
    
    local deployment_dir="$PROJECT_ROOT/DEPLOYMENT"
    
    if [[ -d "$deployment_dir" ]]; then
        log_info "Found DEPLOYMENT directory, removing..."
        if rm -rf "$deployment_dir" 2>/dev/null; then
            CLEANED_DIRS=$((CLEANED_DIRS + 1))
            log_success "Removed DEPLOYMENT directory"
        else
            log_warning "Failed to remove DEPLOYMENT directory"
        fi
    else
        log_info "DEPLOYMENT directory not found"
    fi
}

# Detect and clean Docker resources
detect_and_clean_docker() {
    log_info "Detecting Docker resources..."
    
    # Check if docker is available
    if ! command -v docker &> /dev/null; then
        log_info "Docker not available, skipping Docker cleanup"
        return 0
    fi
    
    # Check if docker daemon is running
    if ! docker info &> /dev/null; then
        log_info "Docker daemon not running, skipping Docker cleanup"
        return 0
    fi
    
    local cleaned_containers=0
    local cleaned_images=0
    
    # Detect Dockerfile in project
    local dockerfiles
    dockerfiles=$(find "$PROJECT_ROOT" -maxdepth 3 -name "Dockerfile" -o -name "*.dockerfile" 2>/dev/null || true)
    
    if [[ -z "$dockerfiles" ]]; then
        log_info "No Dockerfile found in project, skipping Docker cleanup"
        return 0
    fi
    
    log_info "Dockerfile(s) detected, cleaning Docker resources..."
    
    # Get solution/project name for Docker resource identification
    local solution_name
    if [[ -f "$PROJECT_ROOT/Versioner.sln" ]]; then
        solution_name="versioner"
    else
        solution_name=$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]')
    fi
    
    # Stop and remove containers related to this project
    log_info "Checking for Docker containers..."
    local containers
    containers=$(docker ps -aq --filter "name=$solution_name" 2>/dev/null || true)
    
    if [[ -n "$containers" ]]; then
        while IFS= read -r container; do
            [[ -n "$container" ]] || continue
            log_info "Stopping and removing container: $container"
            if docker rm -f "$container" &>/dev/null; then
                cleaned_containers=$((cleaned_containers + 1))
            fi
        done <<< "$containers"
    fi
    
    # Remove images related to this project
    log_info "Checking for Docker images..."
    local images
    images=$(docker images -q --filter "reference=$solution_name*" 2>/dev/null || true)
    
    if [[ -n "$images" ]]; then
        while IFS= read -r image; do
            [[ -n "$image" ]] || continue
            log_info "Removing image: $image"
            if docker rmi -f "$image" &>/dev/null; then
                cleaned_images=$((cleaned_images + 1))
            fi
        done <<< "$images"
    fi
    
    # Clean up dangling images
    log_info "Cleaning up dangling Docker images..."
    docker image prune -f &>/dev/null || true
    
    if [[ $cleaned_containers -gt 0 ]] || [[ $cleaned_images -gt 0 ]]; then
        CLEANED_DOCKER=$((cleaned_containers + cleaned_images))
        log_success "Cleaned Docker: $cleaned_containers container(s), $cleaned_images image(s)"
    else
        log_info "No Docker resources found to clean"
    fi
}

# Clean other temporary files
clean_temp_files() {
    log_info "Cleaning other temporary files..."
    
    local temp_patterns=("*.tmp" "*.temp" "*.backup" "*.cache" "*.swp" "*.swo" "*~")
    local total_cleaned=0
    
    for pattern in "${temp_patterns[@]}"; do
        local temp_files
        temp_files=$(find "$PROJECT_ROOT" -name "$pattern" -type f 2>/dev/null || true)
        
        if [[ -n "$temp_files" ]]; then
            local count=0
            while IFS= read -r file; do
                [[ -n "$file" ]] || continue
                if rm -f "$file" 2>/dev/null; then
                    count=$((count + 1))
                fi
            done <<< "$temp_files"
            
            if [[ $count -gt 0 ]]; then
                total_cleaned=$((total_cleaned + count))
            fi
        fi
    done
    
    # Clean test results
    if [[ -d "$PROJECT_ROOT/TestResults" ]]; then
        if rm -rf "$PROJECT_ROOT/TestResults" 2>/dev/null; then
            CLEANED_DIRS=$((CLEANED_DIRS + 1))
            log_success "Removed TestResults directory"
        fi
    fi
    
    if [[ $total_cleaned -gt 0 ]]; then
        CLEANED_FILES=$((CLEANED_FILES + total_cleaned))
        log_success "Removed $total_cleaned temporary file(s)"
    else
        log_info "No additional temporary files found"
    fi
}

# Show cleanup summary
show_summary() {
    echo ""
    log_info "Cleanup Summary:"
    echo "  Files removed: $CLEANED_FILES"
    echo "  Directories removed: $CLEANED_DIRS"
    echo "  Docker resources cleaned: $CLEANED_DOCKER"
    echo ""
    
    local total=$((CLEANED_FILES + CLEANED_DIRS + CLEANED_DOCKER))
    if [[ $total -gt 0 ]]; then
        log_success "Total items cleaned: $total"
    else
        log_info "No items needed cleaning"
    fi
}

# Main clean process
main() {
    log_info "Starting automatic cleanup process..."
    log_info "Project root: $PROJECT_ROOT"
    
    # Validate environment
    validate_environment
    
    # Clean .bak files
    clean_bak_files
    
    # Clean obj directories
    clean_obj_directories
    
    # Clean bin directories
    clean_bin_directories
    
    # Clean DEPLOYMENT directory
    clean_deployment_directory
    
    # Detect and clean Docker resources
    detect_and_clean_docker
    
    # Clean other temporary files
    clean_temp_files
    
    # Show summary
    show_summary
    
    log_success "Cleanup process completed successfully!"
    return 0
}

# Run main function with all arguments
main "$@"


