<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DatabaseDeletor.Desktop.ViewModels"
             xmlns:m="using:DatabaseDeletor.Domain.Entities"
             x:Class="DatabaseDeletor.Desktop.Views.AnalysisStepView"
             x:DataType="vm:AnalysisStepViewModel">

    <StackPanel Spacing="16">
        <TextBlock Text="Step 3: Dependency Analysis" FontSize="20" FontWeight="Bold" />

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAnalyzing}" />
        <TextBlock Text="Analyzing dependencies..." IsVisible="{Binding IsAnalyzing}" Foreground="#AAAAAA" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel IsVisible="{Binding AnalysisComplete}" Spacing="12">
            <TextBlock FontSize="14">
                <Run Text="Tables in dependency graph: " />
                <Run Text="{Binding TableCount}" FontWeight="Bold" />
            </TextBlock>

            <!-- Dependency Tree -->
            <StackPanel IsVisible="{Binding DependencyTree, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="4">
                <TextBlock Text="Dependency Tree" FontWeight="Bold" FontSize="16" Foreground="CornflowerBlue" />
                <TreeView ItemsSource="{Binding DependencyTree.Children}"
                          MaxHeight="300" BorderThickness="1" BorderBrush="#444" Padding="8">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="m:DependencyTreeNode" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Table.FullName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Table.RowCount, StringFormat='({0:N0} rows)'}" Foreground="#AAAAAA" />
                                <TextBlock IsVisible="{Binding ParentForeignKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Foreground="#888888" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="[{0} → {1}]">
                                            <Binding Path="ParentForeignKey.ConstraintName" FallbackValue="" />
                                            <Binding Path="ParentForeignKey.ReferencingColumn" FallbackValue="" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                    <!-- Root node header -->
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.Styles>
                </TreeView>
                <!-- Root table label above tree -->
                <TextBlock Margin="0,-4,0,0" FontSize="11" Foreground="#888888">
                    <Run Text="Root: " />
                    <Run Text="{Binding DependencyTree.Table.FullName}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>

            <!-- Deletion Order -->
            <StackPanel IsVisible="{Binding DeletionOrder.Count}" Spacing="4">
                <TextBlock Text="Deletion Order (bottom-up)" FontWeight="Bold" FontSize="16" Foreground="CornflowerBlue" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding DeletionOrder}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:TableInfo">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,2">
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RowCount, StringFormat='({0:N0} rows)'}" Foreground="#AAAAAA" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Valid case -->
            <StackPanel IsVisible="{Binding IsValid}" Spacing="4">
                <TextBlock Text="No FK conflicts detected. Ready to proceed." Foreground="LimeGreen" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Conflicts case -->
            <StackPanel IsVisible="{Binding !IsValid}" Spacing="8">
                <TextBlock Text="FK Conflicts Detected" Foreground="Red" FontWeight="Bold" FontSize="16" />

                <DataGrid ItemsSource="{Binding Conflicts}" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="200" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#444">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Excluded Table" Binding="{Binding ExcludedTable.FullName}" Width="*" />
                        <DataGridTextColumn Header="Dependent Table" Binding="{Binding DependentTable.FullName}" Width="*" />
                        <DataGridTextColumn Header="FK Constraint" Binding="{Binding ForeignKey.ConstraintName}" Width="*" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Structured Suggestions -->
                <TextBlock Text="Suggested Actions:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:ResolutionSuggestion">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,2">
                                <TextBlock Text="+" Foreground="LimeGreen" FontWeight="Bold"
                                           IsVisible="{Binding Action, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding TargetTable.FullName}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" Foreground="Orange" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Recommendations:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="Orange" Margin="8,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Go back to Step 1 to adjust table selection." Foreground="#AAAAAA" FontStyle="Italic" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
