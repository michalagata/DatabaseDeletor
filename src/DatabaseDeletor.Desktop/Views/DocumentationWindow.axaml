<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        x:Class="DatabaseDeletor.Desktop.Views.DocumentationWindow"
        Title="Documentation — DatabaseDeletor"
        Width="950" Height="750"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12" Background="#1E1E2E">
            <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Padding="16,8" />
        </Border>

        <md:MarkdownScrollViewer x:Name="MarkdownViewer" Margin="24,16" />
    </DockPanel>
</Window>
