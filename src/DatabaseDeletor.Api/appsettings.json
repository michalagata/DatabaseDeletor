{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FeatureToggles": {
    "SwaggerEnabled": true,
    "HealthCheckEnabled": true,
    "DeletionEndpointsEnabled": true,
    "AnalysisEndpointsEnabled": true,
    "NoExternalCommunication": false
  },
  "OpenTelemetry": {
    "ServiceName": "DatabaseDeletor.Api",
    "OtlpEndpoint": "http://localhost:4317"
  }
}
